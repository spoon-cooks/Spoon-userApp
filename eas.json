{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "staging": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://spoon-api-staging.onrender.com"
      }
    },
    "production-apk": {
      "extends": "production",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6803578695",
        "appleTeamId": "4D772L6YDV",
        "bundleIdentifier": "com.spoonhelp.customer"
      },
      "android": {
        "serviceAccountKeyPath": "./service-account.json",
        "applicationId": "com.spoonhelp.customer",
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    },
    "staging": {
      "ios": {
        "ascAppId": "6829188313",
        "appleTeamId": "4D772L6YDV",
        "bundleIdentifier": "com.spoonhelp.userapp.staging"
      }
    }
  }
}
